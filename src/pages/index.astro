---
import { u } from '../lib/site';
import WorksPanels from '../components/WorksPanels.astro';
import Gtm from '../components/Gtm.astro';
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <Gtm />
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sayaka Kikushima Portfolio</title>
    <link href={u('/css/style.css')} rel="stylesheet" type="text/css">
    <noscript>
        <link href={u('/css/noscript.css')} rel="stylesheet" type="text/css">
    </noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/yakuhanjp@4.0.1/dist/css/yakuhanjp.css">
    <link href="https://fonts.googleapis.com/css2?family=Mukta+Mahee:wght@200;300;400&display=swap" rel="stylesheet">
    
    <link rel="apple-touch-icon" sizes="180x180" href={u('/img/favicon/apple-touch-icon.png')}>
    <link rel="icon" type="image/png" sizes="32x32" href={u('/img/favicon/favicon-32x32.png')}>
    <link rel="icon" type="image/png" sizes="16x16" href={u('/img/favicon/favicon-16x16.png')}>
    <link rel="manifest" href={u('/img/favicon/site.webmanifest')}>
    <link rel="mask-icon" href={u('/img/favicon/safari-pinned-tab.svg')} color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#f5f5f5">
</head>

<body class="c-loading">
    <header class="l-header_top ">
        <div class="c-inner l-header_top_container">
            <div class="l-kv-logo_container c-contain c-inner onclass" data-animate="logo-animation">
                <img src={u('/img/logo-accent.svg')} alt="シンボルマーク">
            </div>
            <h1 class=" c-shoulder u-txtlp">
                <a class="pointer" href={u('/')}><img src={u('/img/portfolio-typo.png')} alt="メインロゴ"></a>
            </h1>
        </div>
    </header>
    <div class="l-header_scroll">
        <div class="scrolldown2">
            <span>Scroll</span><br><br><br>
        </div>
    </div>
    <button class="c-trigger"><span></span></button>
    <nav class="l-nav_top fw200">
        <ul class="l-glb_nav c-inner u-txtlp24 ">
            <li><a href={u('/works/')}><span>Works</span></a></li>
            <li><a href={u('/profile/')}><span>Profile</span></a></li>
            <li id="scrollLink"><a href={u('/contact/')}>Contact</a></li>
        </ul>
    </nav>
    <div class="c-cover"></div>
    <div class="l-kv">
        <div class="l-kv-photo-container" id="slick01">
            <div class="l-kv-photo">
                <img src={u('/img/kv-photo/kv.png')} alt="kvの背景写真1">
            </div>
            <div class="l-kv-photo">
                <img src={u('/img/kv-photo/kv-2.png')} alt="kvの背景写真2">
            </div>
            <div class="l-kv-photo">
                <img src={u('/img/kv-photo/kv.png')} alt="kvの背景写真1">
            </div>
            <div class="l-kv-photo">
                <img src={u('/img/kv-photo/kv-2.png')} alt="kvの背景写真2">
            </div>
        </div>
    </div>
    <main id="top" class="c-inner fw200">
        <section class="c-designtheme l-m6-1-0">
            <div class="message-logo-top">
                <div class="onclass" data-animate="fx04">
                    <img class="c-contain message_sp" src={u('/img/catch/message.png')} alt="価値観">
                    <img class="c-contain message_pc" src={u('/img/catch/message-new.png')} alt="価値観">
                </div>
                <p class="message-caption l-m200 u-txtlp24 onclass" data-animate="fx06">
                    関わる人との「対話」を大切にする。
                </p>
                <p class="message-caption u-txtlp24 onclass" data-animate="fx06">
                    想いを紡ぎ、クリエイティブが架け橋となって顧客とコミュニケーションを築く。
                </p>
                <p class="message-caption u-txtlp24 onclass" data-animate="fx06">
                    「なぜ、誰に、何を、どうやって届けるのか」を考え、熱意を持ってクリエイティブを生み出します。
                </p>
                <div class=" c-button-readmore l-m100top pointer onclass" data-animate="fx03">
                    <p class="readmore_txt u-txtlp24 ">
                        <a href={u('/profile/')}>My VALUE</a>
                    </p>
                </div>
            </div>
        </section>
        <section class="l-works">
            <div class="bg-illust">
                <img class="c-contain" src={u('/img/s-main.svg')} alt="あしらいのイラスト">
            </div>
            <h2 class="l-m3202 u-txtlp48 c-hd_type01 default onclass" data-animate="fx11">
                Works
            </h2>
            <div class="c-tab onclass" data-animate="fx04">
                <ul class="c-tab_list" role="tablist">
                    <li><button class="c-tab_item u-txtlp24 " role="tab"
                            aria-controls="tabpanel02"><span></span>Advertising
                        </button>
                    </li>
                    <li><button class="c-tab_item u-txtlp24" role="tab"
                            aria-controls="tabpanel03"><span></span>Web</button>
                    </li>
                    <li><button class="c-tab_item u-txtlp24" role="tab" aria-controls="tabpanel04"><span></span>Branding
                        </button></li>
                    <li><button class="c-tab_item u-txtlp24" role="tab" aria-controls="tabpanel05"><span>Package</span>
                        </button>
                    </li>
                    <li><button class="c-tab_item u-txtlp24" role="tab"
                            aria-controls="tabpanel06"><span></span>Other</button>
                    </li>
                </ul>
                <WorksPanels />
                <div class="c-button-readmore l-m32-0 pointer onclass fx03" data-animate="fx03">
                    <p class="readmore_txt u-txtl24">
                        <a href={u('/works/')}>Works TOP</a>
                    </p>
                </div>
            </div>
        </section>
        <section>
            <h2 class="l-m3202 u-txtlp48 c-hd_type01 onclass" data-animate="fx11">Photo</h2>
            <div class="c-galley l-m3202 onclass" data-animate="fx04">
                <ul class="gallery-top">
                    <li><a href={u('/img/photo/photo-cookies2.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-cookies2.jpg')} alt="クッキーの写真2"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-cannele1.png')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-cannele1.png')} alt="カヌレの写真1"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-cookies1.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-cookies1.jpg')} alt="クッキーの写真1"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-train.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-train.jpg')} alt="電車の写真"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-train.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-museum.jpg')} alt="国立新美術館"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-train.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-sakura1.jpg')} alt="さくらの写真"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-sora.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-sora.jpg')} alt="空の風景写真2"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-chocolatecake.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-chocolatecake.jpg')} alt="チョコレートケーキの写真1"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-banny1.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-banny1.jpg')} alt="パンの写真1"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-pumpkin.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-pumpkin.jpg')} alt="パンプキンチーズケーキの写真1"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-museum.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-sora2.jpg')} alt="空の風景写真"></a>
                    </li>
                    <li><a href={u('/img/photo/photo-museum.jpg')} data-lightbox="gallery1" data-title="キャプション"><img
                                src={u('/img/photo/photo-typewriter.jpg')} alt="タイプライターの写真"></a></li>
                    <li><a href={u('/img/phot/photo-kichijoji2/photo-sora2.jpg')} data-lightbox="gallery1"
                            data-title="キャプション"><img src={u('/img/photo/photo-kichijoji2.jpg')} alt="吉祥寺の写真"></a>
                    </li>
                </ul>
            </div>
        </section>
        <section class="c-about l-m200px-0">
            <div class="bg-illust">
                <img class="c-contain" src={u('/img/s-main.svg')} alt="あしらいのイラスト">
            </div>
            <h2 class="l-m3202 u-txtlp48 c-hd_type01 onclass" data-animate="fx11">
                Profile
            </h2>
            <div class="l-about_container ">
                <div class=" l-about_inner_container onclass" data-animate="fx04">
                    <div class="l-about-photo_container">
                        <img src={u('/img/profile-photo/profile-photo-new.jpg')} alt="顔写真">
                    </div>
                    <div class="l-about-contents_container">
                        <div class="l-about-contents_container_name">
                            <p class="about_name">
                                <span><img class="name_typo c-contain" src={u('/img/portfolio-typo/profile/name.png')}
                                        alt="自分の名前">
                                </span>
                            </p>
                            <p class="about_name_alphabet u-txtlp24">
                                Sayaka Kikushima
                            </p>
                        </div>
                        <div class="l-about-contents_container_txt">
                            <p class="about_txt">
                                ２０００年生まれ | 東京都出身 | 神奈川県・宮城県育ち<br>
                                趣味 : チョコミント探し | お菓子・パン作り | 喫茶店・建物巡り | 雲を眺める | K-pop
                            </p>
                            <p class="about_txt l-m100">専修大学商学部マーケティング学科卒業
                                大学卒業後<br>東京デザインプレックス研究所
                                デジタルコミュニケーションデザイン専攻 入学/修了
                            </p>
                            <p class="about_txt l-m100">
                                インターンとして、エンジニアの人材紹介会社にてオウンドメディア運用、バナーのデザインを担当後、
                                デジタルマーケティング会社にデザイナーとして入社。<br>Webサイト、LP、バナー、DTPと幅広くデザインのディレクションおよび制作を担当。
                            </p>
                        </div>
                        <div class="l-contents_container_skill_icon ">
                            <p class="u-txtlp24">Skill</p>
                            <div class="skill_icon_container ">
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/ps.svg')} alt="photoshopのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/ai.svg')} alt="illustratorのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/id.svg')} alt="indesignのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/xd.svg')} alt="xdのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/figma.svg')} alt="figmaのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/vscode.svg')} alt="vscodeのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/html.svg')} alt="htmlのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/css.svg')} alt="cssのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/javascript.svg')} alt="javascriptのアイコン">
                                </div>
                                <div class="skill_icon_svg l-m025">
                                    <img src={u('/img/icon/procreate.svg')} alt="procreateのアイコン">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class=" c-button-readmore l-m100top pointer onclass" data-animate="fx03">
                    <p class="readmore_txt u-txtlp24 ">
                        <a href={u('/profile/')}>Read More</a>
                    </p>
                </div>
            </div>
        </section>
    </main>
    <footer class="c-footer_top fw200 ">
        <div class="c-contact_container button pointer">
            <a class="c-contact " href="mailto:mum.fluorite&#64;gmail.com"><img class="c-contain "
                    src={u('/img/icon/mail.svg')} alt="mailのアイコン"><span></span></a>
            <a class="c-return_top " href="#"><span class=" u-txtlp24  ">TOP</span></a>
        </div>
        <div class="l-footer_container c-inner  onclass" data-animate="fx04">
            <div class="l-footer_container_inner">
                <h2 class="l-m45030 u-txtlp48 c-hd_type01 ">Contact</h2>
                <div class="l-footer_nav_container u-txtlp24">
                    <div class="l-footer_nav_container_inner u-txtlp24">
                        <div class="l-footer_nav_icon"><img class="c-contain l-footer_icon" src={u('/img/icon/mail.svg')}
                                alt="mailのアイコン"></div>
                        <p><a href="mailto:mum.fluorite&#64;gmail.com">mum.fluorite@gmail.com</a></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-copy ">&copy;2026 Sayaka
            Kikushima Portfolio
        </div>
    </footer>
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    <script is:inline src="https://unpkg.com/scroll-hint@latest/js/scroll-hint.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/vivus/0.4.4/vivus.min.js"></script>
    <script is:inline src={u('/js/script.js')}></script>
</body>

</html>
