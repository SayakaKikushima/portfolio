---
/**
 * 作品ページ共通の <head> の中身。
 * Googleタグマネージャーの設定は Gtm.astro にあります。
 */
import { u } from '../lib/site';
import Gtm from './Gtm.astro';

interface Props { title: string; fonts?: 'mincho' | 'default'; extraCss?: string[] }
const { title, extraCss = [] } = Astro.props;
---
<Gtm />
<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link href={u('/css/style.css')} rel="stylesheet" type="text/css" />
<noscript><link href={u('/css/noscript.css')} rel="stylesheet" type="text/css" /></noscript>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Mukta+Mahee:wght@200;300;400&family=Sawarabi+Mincho&display=swap" rel="stylesheet" />
{extraCss.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="apple-touch-icon" sizes="180x180" href={u('/img/favicon/apple-touch-icon.png')} />
<link rel="icon" type="image/png" sizes="32x32" href={u('/img/favicon/favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={u('/img/favicon/favicon-16x16.png')} />
<link rel="manifest" href={u('/img/favicon/site.webmanifest')} />
<link rel="mask-icon" href={u('/img/favicon/safari-pinned-tab.svg')} color="#5bbad5" />
<meta name="msapplication-TileColor" content="#da532c" />
<meta name="theme-color" content="#f5f5f5" />
